# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local work. For a specific environment use .env.development
# or .env.production — config/env.js loads .env.<NODE_ENV> first, then .env as
# a base, and real process env (your host's dashboard) beats both.
#
# All .env* files are gitignored except this example. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# development | production
# MUST be production when deployed: any other value turns on debug logging that
# writes ID-document OCR text (name, address, Aadhaar number) to the console.
NODE_ENV=development

PORT=5000

# ── Supabase (required — the server refuses to boot without these) ───────────
SUPABASE_URL=your_supabase_url_here
# Service role key. Bypasses RLS. Server-side only — never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── CORS (required in production) ────────────────────────────────────────────
# Exact scheme + host of the frontend, no trailing slash. Comma-separate to
# allow more than one (e.g. production plus a preview deploy).
# Defaults to http://localhost:5173 in development only.
ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app

# ── Optional ─────────────────────────────────────────────────────────────────
# Without this, OCR returns blank fields and the admin types them by hand.
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Number of proxies between the internet and this app. Decides which
# X-Forwarded-For entry counts as the client IP, which is what the rate limiter
# keys on before a request is authenticated.
#
#   Render / Railway / Fly / Heroku  -> 1
#   Behind your own nginx            -> 1
#   nginx behind Cloudflare          -> 2
#   Running directly, no proxy       -> 0
#
# Use the REAL hop count. Too low and every request looks like it came from the
# proxy, so all users share one bucket. Too high and a client can prepend fake
# X-Forwarded-For entries to mint a fresh bucket per request, disabling rate
# limiting entirely.
TRUST_PROXY=1

# ── Rate limits (per 15 minutes) ─────────────────────────────────────────────
# Keyed per authenticated user, falling back to IP before auth runs.
RATE_LIMIT_MAX=500
# Document upload / OCR calls — each one bills Google Cloud Vision.
RATE_LIMIT_UPLOAD_MAX=40
# /health/db pings. Unauthenticated so a keep-alive cron can reach it; the cap
# bounds how much database load a stranger can generate.
RATE_LIMIT_HEALTH_MAX=60

# ── Caching ──────────────────────────────────────────────────────────────────
# How long a user's role is cached in-process, in ms. Saves one query per
# request. A role change takes up to this long to take effect; set 0 to make
# promotions and demotions instant.
ROLE_CACHE_TTL_MS=60000

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# IANA timezone for the daily 9am rent-reminder cron. Hosts run on UTC, so
# without this it fires at 2:30pm IST.
CRON_TIMEZONE=Asia/Kolkata
