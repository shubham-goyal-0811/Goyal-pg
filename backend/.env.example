PORT=5000
NODE_ENV=production
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here
ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Number of reverse proxies in front of this app (Render/Railway/Fly/nginx = 1).
# Leave at 0 when running directly. Setting this higher than the real hop count
# lets clients forge X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=0

# Requests per 15 min per user (falls back to per-IP before auth).
RATE_LIMIT_MAX=500
# Document upload / OCR calls per 15 min — each one bills Google Cloud Vision.
RATE_LIMIT_UPLOAD_MAX=40
