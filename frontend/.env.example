# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local work. Vite picks the file by mode automatically:
#   npm run dev   -> .env.development, then .env
#   npm run build -> .env.production,  then .env
#
# IMPORTANT: VITE_ vars are inlined at BUILD time, not read at runtime. Changing
# them on the host after a build does nothing — you must rebuild. A production
# build missing any of these now throws at startup instead of silently pointing
# at localhost (see src/lib/env.js).
#
# Everything here ships inside the JS bundle and is publicly readable. The anon
# key is designed for that; RLS is what protects the data. Never put the
# service role key in this file.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend origin, no trailing slash. Must match what the backend allows via
# ALLOWED_ORIGIN in the other direction.
VITE_API_BASE_URL=http://localhost:5000
